# Salesforce External Client App (Connected App) credentials
SF_CLIENT_ID=your_consumer_key_here
SF_CLIENT_SECRET=your_consumer_secret_here

# Must exactly match the Callback URL configured on the External Client App
SF_REDIRECT_URI=http://localhost:5000/auth/callback

# Use https://login.salesforce.com for a normal Developer Edition org,
# or https://test.salesforce.com for a sandbox
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce REST API version
SF_API_VERSION=v60.0

# Where the React app is running (used for CORS + post-login redirect)
FRONTEND_URL=http://localhost:5173

# Random long string used to sign the session cookie
SESSION_SECRET=change_this_to_a_long_random_string

PORT=5000
